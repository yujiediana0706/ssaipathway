# Firebase Web 配置（公开值，客户端初始化用）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin（服务端私有，Cloud Run 可直接使用默认服务账号，本地开发需填）
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini（主模型，服务端私有）
# 方式一：Cloud Run 上设置 GOOGLE_CLOUD_PROJECT，用默认服务账号调 Vertex AI，无需 API Key
# 方式二：本地/无 GCP 凭证时设置 GEMINI_API_KEY，走 Gemini Developer API
GOOGLE_CLOUD_PROJECT=
GEMINI_API_KEY=
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# GLM（备用供应商，Gemini 调用失败时自动兜底；留空则不启用）
GLM_API_KEY=
GLM_API_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4-flash

# Stripe 支付（服务端私有；未配置时下单接口返回 503，页面会提示暂未开放）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
PLATFORM_FEE_RATE=0.2

# 站点与运维
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com
CLEANUP_TOKEN=
