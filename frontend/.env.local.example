# Supabase 数据库配置
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# GLM AI 配置（服务端私有，请勿使用 NEXT_PUBLIC_ 前缀以避免泄露到客户端）
GLM_API_KEY=your_glm_api_key_here
GLM_API_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4-flash

# Vercel deploy note: 确保 Project Settings → General → Node.js Version = 22.x
# 并在 Settings → Environment Variables 中按示例录入后 Redeploy 勾选 Build with latest configuration
